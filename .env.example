# --- Primary LLM provider ---------------------------------------------------
# LLM_PROVIDER selects which client get_llm() constructs as PRIMARY.
# Supported: nvidia, gemini, openai, groq. Its own API key below is
# mandatory - validate_config() fails startup if the primary provider's key
# is missing. In practice this repo only ever configures nvidia as primary;
# groq is wired in purely as a credentialed FALLBACK (see below).
LLM_PROVIDER=nvidia
LLM_MODEL_NAME=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Required when LLM_PROVIDER=nvidia (mandatory for the primary provider).
NVIDIA_API_KEY=

# NVIDIA capacity resilience (backend/services/nvidia_resilience.py). NVIDIA's
# hosted endpoint can return 503 ResourceExhausted under shared-pool
# contention; these bound bounded retry/backoff, concurrency, and circuit-
# breaker behavior before falling back to a different credentialed provider.
# All optional - sane defaults apply if unset.
# NVIDIA_MAX_CONCURRENT_REQUESTS=2
# NVIDIA_MAX_RETRIES=3
# NVIDIA_CIRCUIT_FAILURE_THRESHOLD=3
# NVIDIA_CIRCUIT_COOLDOWN_SECONDS=30.0

# --- Fallback LLM provider (OPTIONAL) ---------------------------------------
# When the PRIMARY provider times out (LLMTimeoutError) or returns a
# transient/malformed response, get_fallback_provider() in
# backend/services/llm.py automatically selects the first CREDENTIALED
# alternative from GROQ_API_KEY (groq) / GOOGLE_API_KEY (gemini) /
# OPENAI_API_KEY (openai), in that order for a nvidia primary, and retries
# once through that provider instead. This works for ANY primary provider,
# not just nvidia.
#
# A fallback credential is entirely OPTIONAL - the application runs
# correctly with only the primary provider's key set. If none of
# GROQ_API_KEY / GOOGLE_API_KEY / OPENAI_API_KEY is set, a primary-provider
# timeout or transient failure is INTENTIONALLY fail-closed (the run fails
# with a classified LLMTimeoutError instead of silently retrying nowhere)
# rather than pretending a fallback exists. GET /health/ready surfaces the
# current primary/fallback configuration under checks.llm_provider so this
# state is always visible, never silent.
#
# Set GROQ_API_KEY (or GOOGLE_API_KEY / OPENAI_API_KEY) here to enable
# automatic fallback even while nvidia stays PRIMARY - you do not need to
# change LLM_PROVIDER. GOOGLE_API_KEY is also the PRIMARY key if you set
# LLM_PROVIDER=gemini instead (LLM_MODEL_NAME e.g. gemini-2.0-flash).
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# To run a controlled, single-provider E2E smoke test (e.g. NVIDIA-only,
# with no automatic fallback even if GOOGLE_API_KEY/OPENAI_API_KEY are
# set), set this to false/0/no. get_fallback_provider() then always
# returns None: a primary-provider failure fails closed with its own
# classified error instead of switching provider. Defaults to enabled
# (true) - this is an explicit opt-out, not something you need to set for
# normal operation. Gemini/OpenAI support itself is never removed by this;
# it only disables the automatic switch-over for as long as it's set.
# LLM_FALLBACK_ENABLED=false

GITHUB_TOKEN=

LOG_LEVEL=INFO
MAX_QA_RETRIES=3
VECTOR_DB_PATH=./data/vector_store
ENVIRONMENT=development
